# ==============================================================================
# MANGA MARKETSQUARE — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or inject into Truehost VPS Docker Environment
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=manga_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD_32_CHARS
POSTGRES_DB=manga_db
DATABASE_URL=postgres://manga_user:REPLACE_WITH_SECURE_DATABASE_PASSWORD_32_CHARS@postgres:5432/manga_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# Backend API Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALLOWED_ORIGINS=https://manga.ng,https://www.manga.ng,https://vendor.manga.ng,https://admin.manga.ng

# Paystack Gateway (Nigeria Escrow & Payments)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Termii Communications (Nigeria SMS & WhatsApp)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Manga
TERMII_WHATSAPP_DEVICE_ID=

# Web Storefront URLs
INTERNAL_API_URL=http://api:4000
NEXT_PUBLIC_API_URL=https://api.manga.ng
NEXT_PUBLIC_VENDOR_URL=https://vendor.manga.ng
NEXT_PUBLIC_ADMIN_URL=https://admin.manga.ng
