{
  "name": "manga-monorepo",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "packageManager": "pnpm@12.21.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "node server.js",
    "dev": "turbo run dev",
    "dev:store": "pnpm --filter @manga/web-store dev",
    "dev:vendor": "pnpm --filter @manga/web-vendor dev",
    "dev:admin": "pnpm --filter @manga/web-admin dev",
    "dev:mobile": "pnpm --filter @manga/mobile start",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^6.3.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "lucide-react": "^1.73.0"
  }
}
