# ==============================================================================
# MANGA MARKETSQUARE — NEXT.JS STOREFRONT ENVIRONMENT VARIABLES
# ==============================================================================

NODE_ENV=production
PORT=3000

# Backend Monolith API Endpoint
# Internal URL used by Next.js Server Components / API routes (e.g., inside Docker network or Truehost localhost)
INTERNAL_API_URL=http://api:4000

# Public API URL used by Browser Client fetchers
NEXT_PUBLIC_API_URL=https://api.manga.ng

# Merchant & Admin Portal Links
NEXT_PUBLIC_VENDOR_URL=https://vendor.manga.ng
NEXT_PUBLIC_ADMIN_URL=https://admin.manga.ng

# Paystack Public Key for Client-Side Inline Popups (Optional, if using Paystack Inline JS)
NEXT_PUBLIC_PAYSTACK_KEY=your_paystack_public_key
