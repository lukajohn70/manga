# ==============================================================================
# MANGA MARKETSQUARE — NEXT.JS STOREFRONT ENVIRONMENT VARIABLES
# ==============================================================================

NODE_ENV=production
PORT=3000

# Backend Monolith API Endpoint
# Internal URL used by Next.js Server Components / API routes (e.g., inside Docker network or Truehost localhost)
INTERNAL_API_URL=http://api:4000

# Public API URL used by Browser Client fetchers
NEXT_PUBLIC_API_URL=https://api.manga.ng

# Storefront Public Domain URL (used in email link generation)
NEXT_PUBLIC_STORE_URL=https://manga.jlm.com.ng

# Merchant & Admin Portal Links
NEXT_PUBLIC_VENDOR_URL=https://manga.jlm.com.ng/sell
NEXT_PUBLIC_ADMIN_URL=https://manga.jlm.com.ng/admin

# Paystack Public Key for Client-Side Inline Popups (Optional, if using Paystack Inline JS)
NEXT_PUBLIC_PAYSTACK_KEY=your_paystack_public_key

# ==============================================================================
# MAILING SYSTEM / SMTP CONFIGURATION
# ==============================================================================
# Official cPanel Outgoing Server for support@manga.jlm.com.ng
SMTP_HOST=manga.jlm.com.ng
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@manga.jlm.com.ng
SMTP_PASS="your_email_account_password"
MAIL_FROM_NAME="MANGA MARKETSQUARE"
MAIL_FROM_ADDRESS=support@jlm.com.ng

# Database Connection (PostgreSQL)
# DATABASE_URL=postgres://username:password@127.0.0.1:5432/manga_db
