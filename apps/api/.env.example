# ==============================================================================
# MANGA MARKETSQUARE — BACKEND MODULAR MONOLITH API ENVIRONMENT VARIABLES
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000

# PostgreSQL Connection String (Truehost Managed Postgres or Docker container)
DATABASE_URL=postgres://manga_user:STRONG_SECURE_PASSWORD_HERE@postgres:5432/manga_db

# Allowed CORS Origins (comma-separated domains)
ALLOWED_ORIGINS=https://manga.ng,https://www.manga.ng,https://vendor.manga.ng,https://admin.manga.ng

# Authentication & Cryptographic Security
# Generate using: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS

# Paystack Payment Gateway Integration (Live Credentials from Paystack Dashboard)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Redis Cache & Outbox (Docker or Managed Redis)
REDIS_URL=redis://redis:6379
